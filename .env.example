# ==============================================================================
# QuickBooks Online API Configuration (Local MCP & AWS Lambda Phase 1)
# ==============================================================================

# Intuit App Credentials (from Intuit Developer Portal)
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_ENVIRONMENT=sandbox

# Lambda / OAuth Callback Settings (Phase 1 Callback Inspection)
# Set REDIRECT_URI to your Lambda Function URL endpoint (e.g. https://<lambda-id>.lambda-url.us-east-1.on.aws/callback)
REDIRECT_URI=https://your-lambda-url.on.aws/callback
QUICKBOOKS_REDIRECT_URI=https://your-lambda-url.on.aws/callback

# Optional Storage / AWS Parameters (commented out / bypassed in Phase 1 callback inspection)
# TABLE_NAME=finos-qbo-broker
# SSM_PREFIX=/finos/qbo

# Additional Local Testing Credentials (Optional for local MCP execution)
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here
QUICKBOOKS_REALM_ID=your_company_id_here

# Restriction Mode — omit or set to false to register all tools
# QUICKBOOKS_DISABLE_WRITE=true    # suppress create_* and create-* tools
# QUICKBOOKS_DISABLE_UPDATE=true   # suppress update_* and update-* tools
# QUICKBOOKS_DISABLE_DELETE=true   # suppress delete_* and delete-* tools

# ==============================================================================
# INTUIT OAUTH CALLBACK PAYLOAD REFERENCE (PHASE 1 LOG / INSPECTION DATA)
# ==============================================================================
# 1. Query String Parameters sent by Intuit to GET /callback:
# {
#   "code": "AB1172... authorization_code ...",
#   "state": "random_csrf_token_string",
#   "realmId": "913035... (QuickBooks Company ID)"
# }
#
# 2. Token Response JSON returned by Intuit POST /oauth2/v1/tokens/bearer:
# {
#   "token_type": "bearer",
#   "expires_in": 3600,
#   "refresh_token": "AB1172... long_lived_refresh_token ...",
#   "x_refresh_token_expires_in": 8726400,
#   "access_token": "eyJhbGci... short_lived_access_token ...",
#   "id_token": "eyJhbGci... (optional OpenID connect token)"
# }
# ==============================================================================

